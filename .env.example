# --- Document Management: Landing AI Agentic Document Extraction ---
# https://va.landing.ai -> API key. Without this, uploads still store and
# version files, but no text is extracted and search finds nothing until a
# key is set and /reextract is called.
VISION_AGENT_API_KEY=
LANDING_AI_ENVIRONMENT=production
LANDING_AI_TIMEOUT_S=180

# --- Server ---
HOST=0.0.0.0
PORT=8020
CORS_ORIGINS=*

# --- Storage ---
DATA_DIR=./data
MAX_UPLOAD_MB=50

# --- Court identity and attestation ---
COURT_ID=DISTRICT-COURT-01
# Replace in any real deployment; see app/services/seals.py on why HMAC is
# only adequate for in-system tamper evidence.
SEAL_SIGNING_KEY=dev-only-insecure-signing-key-change-me
