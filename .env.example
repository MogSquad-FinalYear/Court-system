# --- Document Management: Landing AI Agentic Document Extraction ---
# https://va.landing.ai -> API key. Without this, uploads still store and
# version files, but no text is extracted and search finds nothing until a
# key is set and /reextract is called.
VISION_AGENT_API_KEY=
LANDING_AI_ENVIRONMENT=production
LANDING_AI_TIMEOUT_S=180

# --- Server ---
HOST=0.0.0.0
PORT=8020
CORS_ORIGINS=https://yournyaya.vercel.app

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=veritas-court
JWT_AUDIENCE=veritas-court-api
JWT_ACCESS_TTL_MINUTES=10
JWT_REFRESH_TTL_DAYS=30
AUTH_ALLOW_REGISTRATION=false
AUTH_REGISTRATION_JURISDICTION=KA-BLR
AUTH_REFRESH_COOKIE=veritas_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

DATA_DIR=./data
DB_PATH=./data/court.db
DATABASE_URL=
CLOUDINARY_URL=
MAX_UPLOAD_MB=50

# --- Court identity and attestation ---
COURT_ID=DISTRICT-COURT-01

SEAL_SIGNING_KEY=dev-only-insecure-signing-key-change-me
